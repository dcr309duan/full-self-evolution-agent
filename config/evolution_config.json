{
  "static_predictor": {
    "enabled": true,
    "conflict_threshold": 0.7,
    "max_affected_modules": 5
  },
  "core_cloning_sandbox": {
    "enabled": true,
    "temp_dir": "/tmp/evolution_sandbox",
    "timeout_seconds": 60,
    "max_concurrent_sandboxes": 1,
    "decision_mutations": [
      "goal_selection_threshold",
      "acceptance_criteria",
      "mutation_rate"
    ],
    "log_file": "logs/sandbox_outcomes.log"
  },
  "failure_pattern_learner": {
    "enabled": true,
    "window_size": 50,
    "error_type_patterns": {
      "import_error": "ImportError|ModuleNotFoundError|No module named",
      "type_mismatch": "TypeError|expected.*got|incompatible type",
      "infinite_loop": "Timeout|infinite loop|maximum recursion"
    },
    "operator_failure_thresholds": {
      "disable": 0.7,
      "reduce_by_half": 0.4
    },
    "persist_file": "data/operator_success_rates.json",
    "analysis_interval_cycles": 5
  },
  "ecology_engine": {
    "enabled": true,
    "generation_interval_cycles": 10,
    "max_new_tests_per_cycle": 3,
    "stress_test_probability": 0.3,
    "cross_module_test_probability": 0.4,
    "novel_domain_probability": 0.3,
    "benchmark_sources": ["hackerrank", "leetcode", "codewars", "project_euler"],
    "persist_file": "data/ecology_tests.json",
    "novelty_threshold": 0.7,
    "fitness_tracking_window": 20
  }
}